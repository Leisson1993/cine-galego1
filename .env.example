# ===========================================
# 🎬 CineStream - Variáveis de Ambiente
# ===========================================

# -------------------------------------------
# 🎥 TMDB API (The Movie Database)
# -------------------------------------------
# Obtenha sua chave GRATUITA em: https://www.themoviedb.org/settings/api
# 
# Passos:
# 1. Crie uma conta em https://www.themoviedb.org/signup
# 2. Vá em Settings → API
# 3. Clique em "Create" e escolha "Developer"
# 4. Preencha o formulário (pode usar dados fictícios para teste)
# 5. Copie a "API Key (v3 auth)" e cole abaixo
#
VITE_TMDB_API_KEY=sua_chave_tmdb_aqui

# -------------------------------------------
# 🎬 OMDb API (Optional - para detalhes extras)
# -------------------------------------------
# Obtenha sua chave GRATUITA em: http://www.omdbapi.com/apikey.aspx
# 
# Passos:
# 1. Acesse http://www.omdbapi.com/apikey.aspx
# 2. Escolha "FREE" (1,000 requests por dia)
# 3. Preencha seu email
# 4. Confirme o email
# 5. Copie a API key e cole abaixo
#
VITE_OMDB_API_KEY=sua_chave_omdb_aqui

